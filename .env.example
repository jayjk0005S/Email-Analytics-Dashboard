# Copy this file to .env and add the values from your Microsoft Entra app registration.
# Do not commit the real .env file.
GRAPH_CLIENT_ID=
# Use your Microsoft Entra tenant ID, or "organizations" for a work/school account.
GRAPH_TENANT_ID=organizations

# Optional. The dashboard defaults to data/email_analytics.db.
APP_DB_PATH=data/email_analytics.db

# Email source: outlook_desktop uses the locally installed classic Outlook app.
# Change to graph only after you have completed Microsoft Entra configuration.
MAIL_SOURCE=outlook_desktop

# Privacy: false means the database stores only email metadata. Set true only
# when you explicitly need short email previews for content extraction.
STORE_BODY_PREVIEW=false

# Real-time mode (optional until you create a Microsoft Graph webhook subscription).
# This must be a publicly reachable HTTPS URL; localhost cannot receive Graph webhooks.
PUBLIC_WEBHOOK_URL=
# Generate a long random value locally. It validates that notifications are from Graph.
WEBHOOK_CLIENT_STATE=
WEBHOOK_PORT=8787
# Lightweight signal checks run every second. This is the full-render fallback interval.
DASHBOARD_BACKUP_REFRESH_SECONDS=300
